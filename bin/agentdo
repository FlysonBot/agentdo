#!/usr/bin/env python3
"""
agentdo  --  client shim that forwards a command to the agentdo broker.

Deliberately NOT named `sudo` by default: it does not shadow the system sudo,
and its name does not advertise a privilege path to anyone inspecting the
environment. install.sh can optionally add a `sudo` symlink to this same file
for agents that insist on typing `sudo`; the two names behave identically.

Usage:
    agentdo [sudo-style options] <command> [args...]

Common sudo options are accepted so tools that call `sudo -n ...`, `sudo -u
user ...` or `sudo VAR=value cmd` keep working: see parse_sudo_args().

It connects to the broker's command socket and sends argv (plus cwd and a
filtered env) together with this process's own stdin, stdout and stderr, passed
as file descriptors over SCM_RIGHTS. The privileged command inherits those
descriptors directly, so its input and output stream live between your terminal
and the command -- this shim never sees, buffers, or re-prints the data. Only
the exit code comes back, and agentdo exits with it.

Consequences of that design (all of them deliberate):
  * stdin works: interactive and pipe-reading commands behave normally.
  * Output is not size-capped and binary output is not UTF-8 mangled.
  * Long-running commands stream progressively instead of appearing hung.
  * SIGPIPE on `agentdo foo | head` is handled by the kernel against the real
    command, not by this shim.

If the broker denies the command, agentdo exits 126 with the reason on stderr so
the caller sees a clear, non-crashing signal.
"""

import sys
import os
import socket
import json
import re
import signal

SOCK_PATH = os.environ.get("AGENTDO_SOCK", "/run/agentdo.sock")

# Must match PROTOCOL_VERSION in agentdo-broker.py. A mismatch is reported
# clearly rather than silently misbehaving.
PROTOCOL_VERSION = 2

# Terminal-driven signals we relay to the running command. The client is the
# process the terminal signals, but the COMMAND is what should receive them.
RELAY_SIGNALS = (
    signal.SIGINT, signal.SIGTERM, signal.SIGQUIT,
    signal.SIGHUP, signal.SIGWINCH, signal.SIGTSTP, signal.SIGCONT,
)

# Environment variables forwarded to the privileged command. We do NOT forward
# the whole environment blindly -- a poisoned env should not influence root
# execution more than necessary. Extend deliberately if your workload needs it.
ENV_FORWARD = ("PATH", "LANG", "LC_ALL", "TERM", "TZ")


# --------------------------- sudo-style options ----------------------------- #
#
# Anything that calls `sudo` may pass sudo's own options first. The broker
# always runs commands as root, without prompting, so most of them are no-ops;
# a few map onto a wrapper command; the rest are refused with a clear message
# rather than being mistaken for the command to run.

# Accepted and ignored: the broker never prompts or caches credentials.
_SUDO_IGNORED = frozenset("nSHkKbBPA")
_SUDO_IGNORED_LONG = frozenset((
    "--non-interactive", "--stdin", "--set-home", "--reset-timestamp",
    "--remove-timestamp", "--background", "--askpass"))
# Take a value we have no use for.
_SUDO_VALUE_IGNORED = frozenset("pCrt")
_SUDO_VALUE_IGNORED_LONG = frozenset(
    ("--prompt", "--close-from", "--role", "--type"))
# Cannot be honoured through the broker.
_SUDO_UNSUPPORTED = {
    "i": "-i/--login", "s": "-s/--shell", "g": "-g/--group",
    "l": "-l/--list", "e": "-e/--edit", "V": "-V/--version",
}
_SUDO_UNSUPPORTED_LONG = {
    "--login": "-i/--login", "--shell": "-s/--shell", "--group": "-g/--group",
    "--list": "-l/--list", "--edit": "-e/--edit", "--version": "-V/--version",
}


class _UsageError(Exception):
    pass


def _warn(msg):
    sys.stderr.write(f"agentdo: warning: {msg}\n")


def parse_sudo_args(args):
    """Turn `[sudo options] [VAR=value ...] command...` into the argv to run.

    Returns the argv, or None when there is nothing to run (`sudo -v`).
    Raises _UsageError for options we cannot honour.
    """
    user = chdir = None
    validate = False
    i, n = 0, len(args)

    def value(flag, attached):
        nonlocal i
        if attached:
            return attached
        i += 1
        if i >= n:
            raise _UsageError(f"option '{flag}' requires an argument")
        return args[i]

    saw_dashdash = False
    while i < n:
        a = args[i]
        if a == "--":
            i += 1
            saw_dashdash = True
            break
        if not a.startswith("-") or a == "-":
            break
        if a.startswith("--"):
            name, eq, val = a.partition("=")
            if name in _SUDO_IGNORED_LONG:
                pass
            elif name in _SUDO_VALUE_IGNORED_LONG:
                value(name, val)
            elif name == "--validate":
                validate = True
            elif name == "--preserve-env":
                _warn_preserve_env()
            elif name == "--user":
                user = value(name, val)
            elif name == "--chdir":
                chdir = value(name, val)
            elif name in _SUDO_UNSUPPORTED_LONG:
                raise _UsageError(
                    f"option '{_SUDO_UNSUPPORTED_LONG[name]}' is not "
                    "supported by the agentdo broker")
            else:
                raise _UsageError(f"unknown option '{name}'")
            i += 1
            continue
        # A cluster of short options, e.g. -nE or -nu user or -nuuser.
        cluster, j = a[1:], 0
        while j < len(cluster):
            c = cluster[j]
            j += 1
            if c in _SUDO_IGNORED:
                continue
            if c == "v":
                validate = True
            elif c == "E":
                _warn_preserve_env()
            elif c in _SUDO_VALUE_IGNORED:
                value("-" + c, cluster[j:])
                break
            elif c == "u":
                user = value("-u", cluster[j:])
                break
            elif c == "D":
                chdir = value("-D", cluster[j:])
                break
            elif c in _SUDO_UNSUPPORTED:
                raise _UsageError(
                    f"option '{_SUDO_UNSUPPORTED[c]}' is not supported by "
                    "the agentdo broker")
            else:
                raise _UsageError(f"unknown option '-{c}'")
        i += 1

    # `sudo VAR=value cmd` sets VAR for cmd. Not after `--`: there the next
    # word is the command, even if it looks like an assignment.
    envs = []
    while not saw_dashdash and i < n and _ENV_ASSIGN.match(args[i]):
        envs.append(args[i])
        i += 1

    cmd = list(args[i:])
    if not cmd:
        if validate:
            return None
        raise _UsageError("a command is required")
    if envs:
        cmd = ["env", *envs, *cmd]
    if user not in (None, "root", "0"):
        cmd = ["runuser", "-u", user, "--", *cmd]
    if chdir is not None:
        cmd = ["sh", "-c", 'cd "$1" && shift && exec "$@"', "sh", chdir, *cmd]
    return cmd


_ENV_ASSIGN = re.compile(r"[A-Za-z_][A-Za-z0-9_]*=")


def _warn_preserve_env():
    _warn("-E/--preserve-env is not supported: the broker forwards only "
          + ", ".join(ENV_FORWARD) + "; running anyway without your environment")

def main():
    args = sys.argv[1:]
    if not args:
        sys.stderr.write("agentdo: no command given\n")
        return 2

    try:
        args = parse_sudo_args(args)
    except _UsageError as e:
        sys.stderr.write(f"agentdo: {e}\n")
        return 2
    if args is None:  # `sudo -v`: nothing to run
        return 0

    req = {
        "version": PROTOCOL_VERSION,
        "argv": args,
        "cwd": os.getcwd(),
        "env": {k: os.environ[k] for k in ENV_FORWARD if k in os.environ},
    }

    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.connect(SOCK_PATH)
    except (FileNotFoundError, ConnectionRefusedError, PermissionError) as e:
        sys.stderr.write(f"agentdo: cannot reach broker at {SOCK_PATH}: {e}\n")
        return 127

    # Hand the broker our OWN stdin/stdout/stderr. The privileged command then
    # writes straight to this terminal (or pipe) and reads straight from it:
    # nothing is captured, buffered, re-encoded, or re-printed by us. That is
    # what makes stdin work and what removes the size cap and the UTF-8
    # mangling of binary output.
    #
    # The write side is NOT shut down after the request: the connection stays
    # bidirectional so terminal signals can be relayed to the command while it
    # runs (see _relay_signals).
    try:
        socket.send_fds(s, [json.dumps(req).encode()],
                        [sys.stdin.fileno(), sys.stdout.fileno(),
                         sys.stderr.fileno()])
    except OSError as e:
        sys.stderr.write(f"agentdo: broker connection failed: {e}\n")
        s.close()
        return 127

    try:
        return _converse(s)
    finally:
        s.close()

def _converse(s):
    """Read the broker's reply stream: an optional "started" line, then the
    final result. While the command runs, relay terminal signals to it.

    Handlers are installed BEFORE the first read: a Ctrl-C can land in the
    window between sending the request and the command starting, and the
    default SIGINT handler would raise KeyboardInterrupt out of readline --
    killing this shim and orphaning a command that already holds the terminal.
    Signals arriving that early are queued and flushed once the broker reports
    the command has started.
    """
    f = s.makefile("rb")
    restore = _relay_signals(s)
    try:
        first = f.readline()
        if not first:
            sys.stderr.write(
                "agentdo: broker closed the connection without replying\n")
            return 127
        try:
            resp = json.loads(first)
        except json.JSONDecodeError:
            sys.stderr.write("agentdo: malformed response from broker\n")
            return 127

        # A "started" line means the command is running and we should forward
        # signals until the final result arrives.
        if resp.get("started"):
            _flush_pending(s)
            line = f.readline()
            if not line:
                sys.stderr.write(
                    "agentdo: broker closed the connection while the command "
                    "was running\n")
                return 127
            try:
                resp = json.loads(line)
            except json.JSONDecodeError:
                sys.stderr.write("agentdo: malformed response from broker\n")
                return 127
    except ConnectionResetError:
        sys.stderr.write(
            "agentdo: connection reset by broker (it may have exited)\n")
        return 127
    except OSError as e:
        sys.stderr.write(f"agentdo: broker connection failed: {e}\n")
        return 127
    finally:
        if restore:
            restore()

    if not resp.get("ok"):
        sys.stderr.write("agentdo: " + resp.get("err", "unknown error") + "\n")
        return 126 if resp.get("denied") else 127

    # The command already wrote its own output; only its status comes back.
    return int(resp.get("code", 0))

# Signals that arrive before the broker confirms the command started are held
# here, then flushed once it is safe to deliver them.
_PENDING = {"armed": False, "queue": []}

def _flush_pending(s):
    """Deliver any signals caught before the command was running."""
    _PENDING["armed"] = True
    for sig in _PENDING["queue"]:
        try:
            s.sendall((json.dumps({"signal": sig}) + "\n").encode())
        except OSError:
            break
    _PENDING["queue"].clear()

def _relay_signals(s):
    """Forward terminal signals to the running command; return an undo callable.

    Ctrl-C and window resizes are delivered to THIS process, not to the command
    that owns the terminal. Without this, Ctrl-C killed the shim -- leaving an
    interactive program running with no parent -- and SIGWINCH never arrived,
    so a resized window only reflowed on the command's next redraw.
    """
    previous = {}

    def handler(signum, _frame):
        # Never raise out of a signal handler here: an exception would unwind
        # the socket read and abandon a running command. Deliver, or drop.
        if _PENDING["armed"]:
            try:
                s.sendall((json.dumps({"signal": int(signum)}) + "\n").encode())
            except OSError:
                pass  # command already finished; nothing to signal
        else:
            _PENDING["queue"].append(int(signum))

    for sig in RELAY_SIGNALS:
        try:
            previous[sig] = signal.signal(sig, handler)
        except (OSError, ValueError):
            pass  # not settable on this platform; skip it

    def restore():
        _PENDING["armed"] = False
        _PENDING["queue"].clear()
        for sig, old in previous.items():
            try:
                signal.signal(sig, old)
            except (OSError, ValueError):
                pass
    return restore

if __name__ == "__main__":
    sys.exit(main())
